{
  "name": "mediweb-downloader",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Descarga local y secuencial de reportes MediWeb mediante una sesion manual.",
  "scripts": {
    "start": "node src/index.js",
    "service": "node src/service.js",
    "check": "node scripts/check-js.js",
    "test": "node --test --test-isolation=none",
    "build:windows:staging": "node scripts/build-windows-package.js",
    "build:windows:icon": "node scripts/build-windows-icon.js",
    "build:windows:host": "node scripts/build-windows-host.js",
    "smoke:windows:staging": "node scripts/smoke-windows-staging.js",
    "build:windows:installer": "node scripts/build-windows-installer.js",
    "build:windows": "npm run build:windows:icon && npm run build:windows:staging && npm run smoke:windows:staging && npm run build:windows:installer"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "playwright-core": "^1.54.2"
  },
  "devDependencies": {
    "playwright": "^1.54.2"
  },
  "engines": {
    "node": ">=20"
  }
}
